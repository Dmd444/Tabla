<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.dmd.tabla.PrimaryController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <children>
        <HBox alignment="CENTER" spacing="40.0">
            <children>
                <VBox alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <Label text="Tabla del:" />
                        <TextField fx:id="txtNumero" prefWidth="60.0" />
                    </children>
                </VBox>
                <VBox alignment="CENTER" spacing="10.0">
                    <children>
                        <Button onAction="#calcular" prefWidth="100.0" text="Calcular" />
                        <Button onAction="#limpiar" prefWidth="100.0" text="Limpiar" />
                    </children>
                </VBox>
            </children>
        </HBox>
        <TextArea fx:id="txtTabla" editable="false" prefHeight="250.0" prefWidth="250.0" />
    </children>
</VBox>
